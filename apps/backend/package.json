{
  "name": "@sasthosetu/backend",
  "private": true,
  "version": "0.1.0",
  "description": "Dr.250 backend API",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "node scripts/check.js",
    "db:migrate": "node scripts/migrate.js",
    "test": "node --test --test-concurrency=1",
    "test:database": "node --test test/database-integration.test.js",
    "test:e2e:doctor": "node scripts/doctor-e2e.js",
    "test:e2e:patient": "node scripts/patient-e2e.js",
    "test:isolated": "node --import ./scripts/test-env.js --test --test-concurrency=1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "ws": "^8.21.3"
  }
}
