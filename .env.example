# Backend
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL (Docker Compose)
POSTGRES_HOST=database
POSTGRES_DB=sasthosetu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@database:5432/sasthosetu
DATABASE_SSL=false
# Test-only database; never target production with this URL.
DATABASE_INTEGRATION_URL=postgresql://postgres:postgres@localhost:5432/dr250_test

# Service ports
FRONTEND_PORT=5173
BACKEND_PORT=3000
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://ai-service:8000
AI_REQUEST_TIMEOUT_MS=30000

# Supabase Auth
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
